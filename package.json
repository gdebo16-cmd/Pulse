{
  "name": "pulse",
  "version": "0.1.0",
  "private": true,
  "description": "Pulse — mid-level team status board (Express + React + SQLite)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run server\" \"npm run client\"",
    "server": "node --watch server/src/index.js",
    "client": "npm --prefix client run dev",
    "db:init": "node server/src/db/init.js",
    "test": "node --test tests/**/*.test.js",
    "postinstall": "npm --prefix client install --no-fund --no-audit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
